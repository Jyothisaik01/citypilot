{
  "expo": {
    "name": "CityPilot",
    "slug": "citypilot-mobile",
    "owner": "jyothisai.karumajji",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "citypilot",
    "icon": "./assets/icons/citypilot_app_icon_quadhd.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citypilot.mobility"
    },
    "android": {
      "package": "com.citypilot.mobility",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/citypilot_app_icon_quadhd.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CityPilot uses your location to discover nearby metro stations, live bus transit, and route navigation across Hyderabad."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c933337-e414-4bbf-9fdb-d7bb870ced66"
      }
    }
  }
}
